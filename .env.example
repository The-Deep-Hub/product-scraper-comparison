# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_APP_USERNAME=rust_scraper
MONGO_APP_PASSWORD=rust_scraper_password
MONGO_DATABASE=rust_scraper
MONGO_HOST=localhost
MONGO_PORT=27017

# Redis Configuration
REDIS_PASSWORD=redis_password123
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitmq_password123
RABBITMQ_VHOST=/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h

# Zyte Configuration
ZYTE_API_KEY=your_zyte_api_key
ZYTE_ENDPOINT=https://proxy.zyte.com:8011
ZYTE_CONCURRENT_REQUESTS=5
ZYTE_REQUEST_TIMEOUT=30

# Worker Configuration
WORKER_POLLING_INTERVAL=5
WORKER_MAX_CONCURRENT_TASKS=5

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080